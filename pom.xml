<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.shimeji.miku</groupId>
  <artifactId>MikuShimeji</artifactId>
  <packaging>jar</packaging>
  <version>1.0-SNAPSHOT</version>
  <name>MikuShimeji</name>
  <url>http://maven.apache.org</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
  </properties>
  
  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>3.8.1</version>
      <scope>test</scope>
    </dependency>
        <!-- Thư viện giao diện FlatLaf hiện đại cho Java -->
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
      <version>3.4.1</version>
    </dependency>
  </dependencies>

  <build>
    <!-- 👉 ĐÃ THÊM: Ép Maven đặt tên file đầu ra ngắn gọn -->
    <finalName>MikuShimeji</finalName>
    
    <plugins>
      <!-- 1. Plugin đóng gói file JAR -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <addClasspath>true</addClasspath>
              <mainClass>com.shimeji.miku.App</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- 2. Plugin biến JAR thành EXE và gắn Icon -->
      <plugin>
        <groupId>com.akathist.maven.plugins.launch4j</groupId>
        <artifactId>launch4j-maven-plugin</artifactId>
        <version>2.5.2</version>
        <executions>
          <execution>
            <id>l4j-clui</id>
            <phase>package</phase>
            <goals>
              <goal>launch4j</goal>
            </goals>
            <configuration>
              <!-- Chế độ gui: Khi chạy sẽ không bị hiện cửa sổ đen (CMD) ở nền -->
              <headerType>gui</headerType> 
              <!-- Tên file exe đầu ra -->
              <outfile>${project.build.directory}/${project.artifactId}.exe</outfile>
              <!-- 👉 ĐÃ SỬA LẠI ĐƯỜNG DẪN KHỚP VỚI TÊN FILE JAR NGẮN GỌN -->
              <jar>${project.build.directory}/${project.build.finalName}.jar</jar>
              <errTitle>Miku Shimeji Error</errTitle>
              <classPath>
                <mainClass>com.shimeji.miku.App</mainClass>
              </classPath>
              <!-- ĐƯỜNG DẪN TỚI FILE ICON CỦA BẠN -->
              <icon>src/main/resources/images/miku_icon.ico</icon>
              <jre>
                <!-- Tự động tìm thư mục "jre" mọc ngay cạnh file exe. -->
                <path>jre</path> 
                <minVersion>1.8.0</minVersion>
              </jre>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>